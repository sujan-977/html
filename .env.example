PORT=3000
ADMIN_KEY=change-this-admin-key

# SMTP settings from your email provider.
# For Gmail, use an app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Atithi Restro & Lodge <your-email@gmail.com>"

# Optional staff copy for every booking.
ADMIN_EMAIL=bookings@example.com
