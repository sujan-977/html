PORT=3000
ADMIN_KEY=
# Use a random 32+ character value; this signs the secure, HTTP-only admin session.
ADMIN_SESSION_SECRET=
# Must match the email of an existing Supabase Auth administrator account.
ADMIN_EMAIL=

# Existing Supabase variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=

# SMTP settings from your email provider.
# For Gmail, use an app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=your-app-password
SMTP_FROM="Atithi Restro & Lodge <you@example.com>"

# Optional staff copy for every booking.
# (ADMIN_EMAIL above also controls who may sign into /admin.)
